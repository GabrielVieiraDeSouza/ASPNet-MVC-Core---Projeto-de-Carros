@model IEnumerable<Projeto_Carros.Models.Consumo>

@{
    ViewData["Title"] = "Relatorio";
}

<h1 class="text-center">Relatorio do Veiculo: @ViewBag.Veiculo.Nome</h1>
<h2 class="text-center"> Gastos Totais <p class="text-success">@ViewBag.Total R$</p></h2>

<table class="table">
    <thead>
        <tr>
            <th>Descricao</th>
            <th>Data</th>
            <th>Valor</th>
            <th>Km</th>
            <th>Tipo</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model) {
        <tr>
            <td>@item.Descricao</td>
            <td>@item.Data</td>
            <td>@item.Valor R$</td>
            <td>@item.Km</td>
            <td>@item.Tipo</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn">Editar</a> |
                <a asp-action="Details" asp-route-id="@item.Id" class="btn">Detalhes</a> |
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn">Deletar</a>
            </td>
        </tr>
    }
    </tbody>
</table>
